                Text(
                    text = if (info != null) {
                        "赠送 ${info.grantedBalance} · 充值 ${info.toppedUpBalance} · " +
                            if (data.isAvailable) "可用" else "不可用"
                    } else {
                        if (data.isAvailable) "账户可用" else "账户不可用"
                    },
                    style = TextStyle(color = SubColor, fontSize = 12.sp),
                    maxLines = 2
                )
                Text(
                    "更新于 ${time(data.updatedAt)}",
                    style = TextStyle(color = SubColor, fontSize = 11.sp)
                )
            }

            WidgetData.NoKey -> {
                Text("DeepSeek 余额", style = TextStyle(color = TitleColor, fontSize = 12.sp))
                Spacer(GlanceModifier.height(2.dp))
                Text(
                    "未设置 API Key",
                    style = TextStyle(color = MainColor, fontSize = 18.sp, fontWeight = FontWeight.Bold)
                )
                Text("点击此处打开 App 填写", style = TextStyle(color = SubColor, fontSize = 12.sp))
            }

            is WidgetData.Err -> {
                Text("DeepSeek 余额", style = TextStyle(color = TitleColor, fontSize = 12.sp))
                Spacer(GlanceModifier.height(2.dp))
                Text(
                    "获取失败",
                    style = TextStyle(color = ErrColor, fontSize = 18.sp, fontWeight = FontWeight.Bold)
                )
                Text(
                    data.message,
                    style = TextStyle(color = SubColor, fontSize = 11.sp),
                    maxLines = 2
                )
            }
        }

        Spacer(GlanceModifier.height(10.dp))
        Text(
            text = "刷新",
            modifier = GlanceModifier
                .background(AccentColor)
                .cornerRadius(14.dp)
                .padding(horizontal = 14.dp, vertical = 7.dp)
                .clickable(actionRunCallback<RefreshAction>()),
            style = TextStyle(color = OnAccent, fontSize = 13.sp)
        )
    }
}
