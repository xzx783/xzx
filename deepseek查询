/* ---------- 配色 ---------- */

private val CardBg = ColorProvider(Color(0xFFF4F5F7), Color(0xFF1C1C1E))
private val TitleColor = ColorProvider(Color(0xFF6B7280), Color(0xFF9AA0A6))
private val MainColor = ColorProvider(Color(0xFF111827), Color(0xFFF3F4F6))
