/* ---------- 数据状态 ---------- */

private sealed interface WidgetData {
    data class Ok(
        val isAvailable: Boolean,
        val infos: List<BalanceInfo>,
        val updatedAt: Long
    ) : WidgetData

    data class Err(val message: String) : WidgetData
    data object NoKey : WidgetData
}

private suspend fun loadData(context: Context): WidgetData {
    val key = Prefs(context).apiKey
    if (key.isBlank()) return WidgetData.NoKey
    return try {
        val r = DeepSeekApi.fetchBalance(key)
        WidgetData.Ok(r.isAvailable, r.infos, System.currentTimeMillis())
    } catch (t: Throwable) {
        WidgetData.Err(t.message ?: "未知错误")
    }
}

private fun time(ts: Long) =
    SimpleDateFormat("HH:mm", Locale.getDefault()).format(Date(ts))

