package com.example.deepseekbalance

import android.app.Application
import androidx.lifecycle.AndroidViewModel
import androidx.lifecycle.viewModelScope
import com.example.deepseekbalance.widget.updateBalanceWidgets
import kotlinx.coroutines.CancellationException
import kotlinx.coroutines.Job
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.update
import kotlinx.coroutines.launch

sealed interface BalanceState {
    data object Idle : BalanceState
    data object Loading : BalanceState
    data class Success(val result: BalanceResult) : BalanceState
    data class Error(val message: String) : BalanceState
}

data class BalanceUiState(
    val apiKey: String = "",
    val state: BalanceState = BalanceState.Idle,
    val lastUpdated: Long? = null
) {
    val hasKey: Boolean get() = apiKey.isNotBlank()
}

class BalanceViewModel(app: Application) : AndroidViewModel(app) {

    private val prefs = Prefs(app)
    private val _uiState = MutableStateFlow(BalanceUiState(apiKey = prefs.apiKey))
    val uiState: StateFlow<BalanceUiState> = _uiState.asStateFlow()
    private var job: Job? = null

    init {
        if (prefs.apiKey.isNotBlank()) refresh()
    }

    fun saveApiKey(key: String) {
        val trimmed = key.trim()
        prefs.apiKey = trimmed
        _uiState.update { it.copy(apiKey = trimmed) }
        refresh()
    }

    fun clearApiKey() {
        job?.cancel()
        prefs.apiKey = ""
        _uiState.value = BalanceUiState()
        viewModelScope.launch { updateBalanceWidgets(getApplication()) }
    }

    fun refresh() {
        val key = _uiState.value.apiKey
        if (key.isBlank()) return
        job?.cancel()
        _uiState.update { it.copy(state = BalanceState.Loading) }
        job = viewModelScope.launch {
            try {
                val result = DeepSeekApi.fetchBalance(key)
                _uiState.update {
                    it.copy(state = BalanceState.Success(result), lastUpdated = System.currentTimeMillis())
                }
                updateBalanceWidgets(getApplication())
            } catch (ce: CancellationException) {
                throw ce
            } catch (t: Throwable) {
                _uiState.update { it.copy(state = BalanceState.Error(t.message ?: "未知错误")) }
                updateBalanceWidgets(getApplication())
            }
        }
    }
}
EOF_VM

