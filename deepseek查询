package com.example.deepseekbalance

import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import org.json.JSONObject
import java.net.HttpURLConnection
import java.net.URL

data class BalanceInfo(
    val currency: String,
    val totalBalance: String,
    val grantedBalance: String,
    val toppedUpBalance: String
)

data class BalanceResult(
    val isAvailable: Boolean,
    val infos: List<BalanceInfo>
)

object DeepSeekApi {

    private const val ENDPOINT = "https://api.deepseek.com/user/balance"

    suspend fun fetchBalance(apiKey: String): BalanceResult = withContext(Dispatchers.IO) {
        val conn = (URL(ENDPOINT).openConnection() as HttpURLConnection).apply {
            requestMethod = "GET"
            connectTimeout = 15_000
            readTimeout = 15_000
            setRequestProperty("Accept", "application/json")
            setRequestProperty("Authorization", "Bearer $apiKey")
        }
        try {
            val code = conn.responseCode
            val body = (if (code in 200..299) conn.inputStream else conn.errorStream)
                ?.bufferedReader()?.use { it.readText() }.orEmpty()

            if (code !in 200..299) {
                val msg = runCatching {
                    JSONObject(body).optJSONObject("error")?.optString("message")
                }.getOrNull().orEmpty()
                throw IllegalStateException(
                    if (code == 401) "API Key 无效或已过期（401）"
                    else "请求失败：HTTP $code${if (msg.isNotBlank()) " · $msg" else ""}"
                )
            }

            val json = JSONObject(body)
            val arr = json.optJSONArray("balance_infos")
            val infos = buildList {
                if (arr != null) {
                    for (i in 0 until arr.length()) {
                        val o = arr.getJSONObject(i)
                        add(
                            BalanceInfo(
                                currency = o.optString("currency", "CNY"),
                                totalBalance = o.optString("total_balance", "-"),
                                grantedBalance = o.optString("granted_balance", "-"),
                                toppedUpBalance = o.optString("topped_up_balance", "-")
                            )
                        )
                    }
                }
            }
            BalanceResult(json.optBoolean("is_available", false), infos)

        } catch (e: java.io.IOException) {
            throw IllegalStateException("网络异常：${e.message ?: "请检查网络连接"}")
        } finally {
            conn.disconnect()
        }
    }
}
EOF_API

